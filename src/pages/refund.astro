---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// One constant, two consumers: the sentence a human reads in §2 and the
// `merchantReturnDays` a search engine reads. Writing the number twice is how
// the pricing JSON-LD came to describe a model we stopped selling four months
// earlier (#373) — and a refund window is a stronger claim than a price, because
// it is a term of sale.
const REFUND_WINDOW_DAYS = 14;

// Paddle is the Merchant of Record, so the return policy belongs to the selling
// entity and is linked from the Organization rather than from an Offer. No
// `applicableCountry`: the window is worldwide and naming a subset would narrow
// a commitment we have not narrowed.
const merchantReturnPolicy = {
  "@context": "https://schema.org",
  "@type": "MerchantReturnPolicy",
  name: "Datanika Refund Policy",
  url: "https://datanika.io/refund/",
  returnPolicyCategory: "https://schema.org/MerchantReturnFiniteReturnWindow",
  merchantReturnDays: REFUND_WINDOW_DAYS,
  refundType: "https://schema.org/FullRefund",
  returnFees: "https://schema.org/FreeReturn",
  returnMethod: "https://schema.org/ReturnByMail",
  merchantReturnLink: "https://datanika.io/refund/",
  inStoreReturnsOffered: false,
  itemCondition: "https://schema.org/NewCondition",
  merchantOfRecord: {
    "@type": "Organization",
    name: "Paddle.com Market Ltd",
    url: "https://www.paddle.com/",
  },
  provider: {
    "@type": "Organization",
    name: "Datanika",
    url: "https://datanika.io",
  },
};
---

<Layout
  title="Refund Policy — Datanika"
  description="Refund Policy for Datanika data pipeline platform."
  extraJsonLd={[merchantReturnPolicy]}
>
  <Navbar />
  <main class="mx-auto max-w-4xl px-6 py-20">
    <h1 class="mb-2 text-4xl font-bold gradient-text">Refund Policy</h1>
    <p class="mb-10 text-sm text-slate-500">Last updated: March 10, 2026</p>

    <div class="space-y-8 text-slate-300 leading-relaxed [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-white [&_h2]:mb-3 [&_ul]:list-disc [&_ul]:pl-6 [&_ul]:space-y-1">

      <section>
        <h2>1. Overview</h2>
        <p>Datanika offers a free tier with no payment required. Paid subscriptions (Pro, Enterprise) are billed on a recurring basis through Paddle.com, our Merchant of Record. This policy outlines how refunds and cancellations are handled.</p>
      </section>

      <section>
        <h2>2. Refund Window</h2>
        <p>If you are not satisfied with your purchase for any reason, you can request a full refund within <strong>{REFUND_WINDOW_DAYS} days</strong> of the initial purchase or renewal date. No questions asked.</p>
      </section>

      <section>
        <h2>3. How to Request a Refund</h2>
        <p>To request a refund, contact us at <a href="mailto:info@datanika.io" class="text-violet-400 hover:underline">info@datanika.io</a> with your account email. Refunds are processed by Paddle and typically appear within 5–10 business days depending on your payment provider.</p>
      </section>

      <section>
        <h2>4. Cancellations</h2>
        <p>You may cancel your subscription at any time. Upon cancellation, you will retain access to paid features until the end of your current billing period. After that, your account will revert to the Free plan.</p>
      </section>

      <section>
        <h2>5. Contact</h2>
        <p>For billing questions, contact us at <a href="mailto:info@datanika.io" class="text-violet-400 hover:underline">info@datanika.io</a>.</p>
        <p class="mt-2 text-sm text-slate-500">Datanika (Individual Entrepreneur Evgenii Timofeev)<br />Mikheil Tsinamdzgvrishvili st. 52, Tbilisi, Georgia<br />ID: 302355868</p>
      </section>

    </div>
  </main>
  <Footer />
</Layout>
