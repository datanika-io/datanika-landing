---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ConversionCTA from "../../components/ConversionCTA.astro";
import { connectors, availableConnectors, sourceConnectors, destinationConnectors, directionLabel } from "../../data/connectors";
import type { Connector } from "../../data/connectors";
import { useCases } from "../../data/use-cases";
import { templates } from "../../data/templates";
import { existsSync } from "fs";
import { resolve } from "path";

export function getStaticPaths() {
  return connectors.map((c) => ({
    params: { slug: c.slug },
    props: { connector: c },
  }));
}

interface Props {
  connector: Connector;
}

const { connector } = Astro.props;
const directionColor =
  connector.direction === "both"
    ? "bg-violet-500/20 text-violet-300"
    : connector.direction === "destination"
      ? "bg-cyan-500/20 text-cyan-300"
      : "bg-slate-800 text-slate-400";

// Where this connector's data can go, derived. These pages rank for
// destination-directed queries — `export slack to postgresql` sits at position
// 13.5 — and the page never named a destination (#378, #379). Deriving it means
// a `direction` change carries the copy with it, which is what the prose split
// failed to do (#376), and it cannot name something we do not support (#391).
// Ordering only — the SET is derived and complete; this decides which four get
// named in the one-line summary. Taken from the destinations that actually
// appear in our GSC queries (`export slack to postgresql` 13.5, `pipedrive to
// bigquery` 16.6, `asana to bigquery` 18.1). Data-file order put the four
// smallest databases first and BigQuery nowhere.
const DESTINATION_BILLING_ORDER = ["postgresql", "bigquery", "snowflake", "clickhouse", "mysql"];
const destinationsForThis = destinationConnectors
  .filter((c) => c.slug !== connector.slug)
  .sort((a, b) => {
    const rank = (slug: string) => {
      const i = DESTINATION_BILLING_ORDER.indexOf(slug);
      return i === -1 ? DESTINATION_BILLING_ORDER.length : i;
    };
    return rank(a.slug) - rank(b.slug);
  });

// Only a SQL database source renders write-disposition / load-mode / source-schema
// / table-name controls. See the callout carried by the other twenty-four guides.
const isSqlSource = connector.category === "Database";

const relatedConnectors = connector.related
  .map((slug) => connectors.find((c) => c.slug === slug))
  .filter(Boolean) as Connector[];

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Connectors", url: "/connectors" },
  { name: connector.name, url: `/connectors/${connector.slug}` },
];

// SEO overrides from plans/SEO_KEYWORDS.md Tier 1 rewrite pass.
// Falls back to default pattern when not set.
const pageTitle = connector.seoTitle ?? `${connector.name} Connector — Datanika`;
const pageDescription = connector.seoDescription ?? connector.description;
const pageH1 = connector.seoH1 ?? connector.name;

// Limitation copy cites tracking issues as bare `core#NNN` / `cloud#NNN` so the
// strings stay greppable when an issue closes. Turn those into real links here
// rather than hand-writing anchors into the data file.
const escapeHtml = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const linkifyIssues = (s: string) =>
  escapeHtml(s).replace(
    /\b(core|cloud|landing)#(\d+)\b/g,
    (_m, repo, num) =>
      `<a href="https://github.com/datanika-io/datanika-${repo === "core" ? "core" : repo}/issues/${num}" class="text-violet-300 underline underline-offset-2 hover:text-violet-200">${repo}#${num}</a>`,
  );

// Auto-compute cross-type internal links
const matchingUseCases = useCases.filter(
  (uc) => uc.sourceSlug === connector.slug || uc.destinationSlug === connector.slug
);

// Pipeline Templates that use this connector as source or destination.
// Only a handful of connectors match today (3 templates × 2 sides), so the
// section renders only on pages where at least one template is relevant.
const matchingTemplates = templates.filter(
  (tpl) =>
    tpl.sourceConnectorSlug === connector.slug ||
    tpl.destinationConnectorSlug === connector.slug,
);

const setupGuideExists = existsSync(
  resolve(process.cwd(), `src/content/connectors/${connector.slug}.md`)
);

const comparisonSlugs = ["airbyte", "fivetran", "stitch", "hevo"];
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  ogCollection="connectors"
  ogSlug={connector.slug}
>
  <Navbar />

  <!-- Hero -->
  <section class="relative pt-32 pb-16 overflow-hidden">
    <div class="glow bg-violet-600 -top-40 -left-40"></div>
    <div class="glow bg-cyan-600 -bottom-40 -right-40"></div>
    <div class="relative max-w-4xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-4">
        <span class="text-sm text-slate-500">{connector.category}</span>
        <span class={`text-xs px-2 py-0.5 rounded-full ${directionColor}`}>
          {directionLabel(connector.direction)}
        </span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">
        <span class="gradient-text">{pageH1}</span>
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed max-w-3xl">
        {connector.description}
      </p>
      {connector.withdrawn && (
        <div class="mt-6 rounded-2xl border border-amber-500/40 bg-amber-500/10 p-5 max-w-3xl">
          <p class="text-sm font-semibold text-amber-200 mb-2">Temporarily unavailable</p>
          <p class="text-sm text-slate-300 leading-relaxed" set:html={linkifyIssues(connector.withdrawn)} />
        </div>
      )}
      {connector.direction !== "destination" && (
        <p class="mt-5 text-slate-300">
          <span class="text-white font-medium">Where it can go:</span> load {connector.name} into
          {" "}{destinationsForThis.slice(0, 4).map((d) => d.name).join(", ")} or any of the
          {" "}<a href="#destinations" class="text-violet-400 underline hover:text-violet-300">{destinationsForThis.length} supported destinations</a>.
        </p>
      )}
      {connector.direction === "destination" && (
        <p class="mt-5 text-slate-300">
          <span class="text-white font-medium">{connector.name} is a destination.</span> Load data into it
          from any of the <a href="/connectors" class="text-violet-400 underline hover:text-violet-300">{sourceConnectors.length} source connectors</a>.
          Datanika does not extract from {connector.name}.
        </p>
      )}
      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <ConversionCTA href="https://app.datanika.io/signup" class="btn-primary">
          Connect {connector.name}
        </ConversionCTA>
        <a href="/docs/connections" class="btn-secondary">View docs</a>
      </div>
    </div>
  </section>

  <!-- Use Cases -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6">Use Cases</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        {connector.useCases.map((uc) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5">
            <p class="text-slate-300">{uc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Configuration -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6">Configuration</h2>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur overflow-hidden">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-slate-800">
              <th class="px-6 py-4 text-sm font-semibold text-slate-300 uppercase tracking-wider">Field</th>
              <th class="px-6 py-4 text-sm font-semibold text-slate-300 uppercase tracking-wider">Description</th>
            </tr>
          </thead>
          <tbody>
            {connector.configFields.map((f, i) => (
              <tr class={`border-b border-slate-800/50 ${i % 2 === 0 ? "bg-slate-900/30" : ""}`}>
                <td class="px-6 py-3 text-violet-300 font-mono text-sm">{f.name}</td>
                <td class="px-6 py-3 text-slate-300 text-sm">{f.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-sm text-slate-500 mt-4">
        All credentials are <strong class="text-slate-400">encrypted at rest</strong> with Fernet before being stored in the database.
      </p>

      {connector.limitations && connector.limitations.length > 0 && (
        <div class="mt-8 rounded-2xl border border-amber-500/30 bg-amber-500/5 p-6">
          <h3 class="text-lg font-semibold text-amber-200 mb-3">
            Current limitations
          </h3>
          <p class="text-sm text-slate-400 mb-4">
            What this connector cannot do yet. We would rather tell you here than
            have you find out at the first run.
          </p>
          <ul class="space-y-3">
            {connector.limitations.map((lim) => (
              <li class="flex gap-3 text-sm text-slate-300 leading-relaxed">
                <span class="text-amber-400/70 select-none">—</span>
                <span set:html={linkifyIssues(lim)} />
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6">How It Works</h2>
      <ol class="space-y-4">
        <li class="flex gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-500/20 text-violet-300 font-bold text-sm shrink-0">1</span>
          <div>
            <p class="text-white font-medium">Add a {connector.name} connection</p>
            <p class="text-sm text-slate-400">Navigate to Connections, click New, select {connector.name}, and enter your credentials.</p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-500/20 text-violet-300 font-bold text-sm shrink-0">2</span>
          <div>
            {connector.direction === "both" && (
              <>
                <p class="text-white font-medium">Use as source, destination, or both</p>
                <p class="text-sm text-slate-400">Extract data from {connector.name} into another destination, or load data from other sources into {connector.name}.</p>
              </>
            )}
            {connector.direction === "destination" && (
              <>
                <p class="text-white font-medium">Pick the source to load from</p>
                <p class="text-sm text-slate-400">{connector.name} is the destination. Choose any of the {sourceConnectors.length} source connectors — databases, SaaS APIs, files or streams — as the other half of the upload.</p>
              </>
            )}
            {connector.direction === "source" && (
              <>
                <p class="text-white font-medium">Choose a destination</p>
                <p class="text-sm text-slate-400">Select where to load your {connector.name} data — {destinationsForThis.slice(0, 3).map((d) => d.name).join(", ")}, or any of the other {destinationsForThis.length - 3}.</p>
              </>
            )}
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-500/20 text-violet-300 font-bold text-sm shrink-0">3</span>
          <div>
            <p class="text-white font-medium">Create an upload and run it</p>
            <p class="text-sm text-slate-400">
              Set up an upload with your source and destination{isSqlSource ? ", choose a load mode," : ""} and click Run.
              Datanika handles extraction, schema mapping, and loading automatically via dlt.
              {!isSqlSource && connector.direction !== "destination" && " There is no write-disposition, load-mode, source-schema or table-name field for this source — those are rendered only for SQL databases. You pick which endpoints to load instead."}
            </p>
          </div>
        </li>
        <li class="flex gap-4">
          <span class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-500/20 text-violet-300 font-bold text-sm shrink-0">4</span>
          <div>
            <p class="text-white font-medium">Transform and schedule</p>
            <p class="text-sm text-slate-400">Write dbt models to transform the loaded data, build pipelines, and set up automated schedules.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- Destinations / sources: the second half of the query these pages rank for -->
  <section id="destinations" class="py-16 border-t border-slate-800">
    <div class="max-w-4xl mx-auto px-6">
      {connector.direction === "destination" ? (
        <>
          <h2 class="text-2xl font-bold mb-3">Sources you can load into {connector.name}</h2>
          <p class="text-slate-400 mb-6">
            {connector.name} is a destination. Any of the {sourceConnectors.length} source connectors can
            load into it — databases, SaaS APIs, files and streams. Datanika does not extract data
            <em>from</em> {connector.name}.
          </p>
          <a href="/connectors" class="btn-secondary">Browse all {availableConnectors.length} connectors</a>
        </>
      ) : (
        <>
          <h2 class="text-2xl font-bold mb-3">Where {connector.name} data can go</h2>
          <p class="text-slate-400 mb-6">
            Every destination below works with {connector.name}. Pick one when you create the upload —
            there is nothing to configure on the {connector.name} side to enable it.
          </p>
          <div class="flex flex-wrap gap-2">
            {destinationsForThis.map((d) => (
              <a
                href={`/connectors/${d.slug}`}
                class="rounded-full border border-slate-700 bg-slate-900/60 px-4 py-1.5 text-sm text-slate-300 transition-colors hover:border-violet-500/50 hover:text-white"
              >
                {connector.name} &rarr; {d.name}
              </a>
            ))}
          </div>
        </>
      )}
    </div>
  </section>

  <!-- Setup Guide CTA -->
  {setupGuideExists && (
    <section class="py-8">
      <div class="max-w-4xl mx-auto px-6">
        <a href={`/docs/connectors/${connector.slug}`} class="block rounded-2xl border border-violet-500/30 bg-violet-500/5 p-6 transition-colors hover:border-violet-500/50">
          <div class="flex items-center gap-3">
            <span class="text-violet-400 text-xl">📖</span>
            <div>
              <p class="font-semibold text-white">{connector.name} Setup Guide</p>
              <p class="text-sm text-slate-400">Step-by-step configuration, credentials, and verified connection walkthrough →</p>
            </div>
          </div>
        </a>
      </div>
    </section>
  )}

  <!-- Pipeline Templates using this connector -->
  {matchingTemplates.length > 0 && (
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl font-bold mb-6">Templates with {connector.name}</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {matchingTemplates.map((tpl) => (
            <a
              href={`/templates/${tpl.slug}`}
              class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-violet-500/50"
            >
              <div class="flex items-center gap-2 text-sm text-slate-500 mb-2">
                <span class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-400">{tpl.source}</span>
                <span class="text-slate-600">→</span>
                <span class="px-2 py-0.5 rounded-full bg-violet-500/20 text-violet-300">{tpl.destination}</span>
              </div>
              <p class="font-semibold text-white">{tpl.h1}</p>
              <p class="text-sm text-slate-400 mt-1 line-clamp-2">{tpl.tagline}</p>
              <p class="text-xs text-slate-500 mt-2">{tpl.timeToFirstRun} to first run</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Matching Use Cases -->
  {matchingUseCases.length > 0 && (
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl font-bold mb-6">Use Cases with {connector.name}</h2>
        <div class="grid sm:grid-cols-2 gap-4">
          {matchingUseCases.map((uc) => (
            <a
              href={`/use-cases/${uc.slug}`}
              class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-violet-500/50"
            >
              <div class="flex items-center gap-2 text-sm text-slate-500 mb-2">
                <span class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-400">{uc.source}</span>
                <span class="text-slate-600">→</span>
                <span class="px-2 py-0.5 rounded-full bg-violet-500/20 text-violet-300">{uc.destination}</span>
              </div>
              <p class="font-semibold text-white">{uc.title}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Compare Alternatives -->
  <section class="py-8">
    <div class="max-w-4xl mx-auto px-6">
      <p class="text-sm text-slate-500">Evaluating alternatives? Compare Datanika with{" "}
        {comparisonSlugs.map((slug, i) => (
          <>{i > 0 && ", "}<a href={`/compare/${slug}`} class="text-violet-400 hover:underline">{slug.charAt(0).toUpperCase() + slug.slice(1)}</a></>
        ))}.
      </p>
    </div>
  </section>

  <!-- Related Connectors -->
  {relatedConnectors.length > 0 && (
    <section class="py-16">
      <div class="max-w-4xl mx-auto px-6">
        <h2 class="text-2xl font-bold mb-6">Related Connectors</h2>
        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {relatedConnectors.map((rc) => (
            <a
              href={`/connectors/${rc.slug}`}
              class="rounded-xl border border-slate-800 bg-slate-900/50 p-4 transition-colors hover:border-violet-500/50 text-center"
            >
              <p class="font-semibold text-white">{rc.name}</p>
              <p class="text-xs text-slate-500 mt-1">{rc.category}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur p-12">
        <h2 class="text-3xl font-bold mb-4">
          Start using {connector.name} with Datanika
        </h2>
        <p class="text-slate-400 mb-8 text-lg">
          Free to start — no credit card required. Connect {connector.name} in minutes.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <ConversionCTA href="https://app.datanika.io/signup" class="btn-primary">Start Free</ConversionCTA>
          <a href="/connectors" class="btn-secondary">View all connectors</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
