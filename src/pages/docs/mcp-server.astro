---
import DocsLayout from "../../layouts/DocsLayout.astro";

// Tool inventory mirrors datanika-core/datanika-mcp/src/datanika_mcp/server.py.
// 17 read-only tools are always registered; the 8 write tools refuse to run
// unless the server was started with --allow-write. If you add a tool in core,
// add it here and bump the counts in tests/mcp-server.test.ts.
const readTools = [
  {
    group: "Discover & introspect",
    tools: [
      { name: "get_agent_tiers", desc: "Fetch the 5-tier agent capability stack — what the API can do." },
      { name: "get_connection_types", desc: "List every supported connector with its typed config schema." },
      { name: "list_connections", desc: "List the connections in your organization." },
      { name: "get_connection", desc: "Get one connection by ID." },
      { name: "introspect_connection", desc: "List the schemas and tables inside a source connection." },
      { name: "preview_connection", desc: "Read the first N rows of a source table (default 100)." },
      { name: "query_connection", desc: "Run a single read-only SELECT against a source connection." },
    ],
  },
  {
    group: "Validate",
    tools: [
      { name: "compile_transformation", desc: "Compile a dbt model — resolves Jinja, ref(), source(). Nothing executes." },
      { name: "preview_transformation", desc: "Compile and execute a model, returning preview rows." },
    ],
  },
  {
    group: "Observe",
    tools: [
      { name: "list_uploads", desc: "List uploads (extract + load jobs)." },
      { name: "list_pipelines", desc: "List pipelines (dbt orchestration)." },
      { name: "list_transformations", desc: "List dbt transformations." },
      { name: "list_runs", desc: "List runs, filterable by target type and status." },
      { name: "get_run", desc: "Get one run by ID." },
      { name: "get_run_logs", desc: "Fetch the logs for a run — how the agent debugs a failure." },
      { name: "list_catalog", desc: "List catalog entries (source tables and dbt models)." },
      { name: "get_catalog_entry", desc: "Get one catalog entry by ID." },
    ],
  },
];

const writeTools = [
  {
    group: "Build",
    tools: [
      { name: "create_connection", desc: "Create a data connection from a type plus its config." },
      { name: "create_upload", desc: "Create an upload (extract + load) between two connections." },
      { name: "create_pipeline", desc: "Create a pipeline that runs a dbt command." },
      { name: "create_transformation", desc: "Create a dbt SQL model with a materialization and target schema." },
      { name: "bulk_import", desc: "Create connections, uploads, pipelines and models in one validated call." },
    ],
  },
  {
    group: "Execute",
    tools: [
      { name: "trigger_upload", desc: "Run an upload. Pass wait to block until it finishes." },
      { name: "trigger_pipeline", desc: "Run a pipeline (dbt build/run/test)." },
      { name: "trigger_transformation", desc: "Run a single transformation." },
    ],
  },
];

const readCount = readTools.reduce((n, g) => n + g.tools.length, 0);
const writeCount = writeTools.reduce((n, g) => n + g.tools.length, 0);
const toolCount = readCount + writeCount;

// Config snippets live in the frontmatter so the braces don't need escaping
// in the template. Astro renders `{snippet}` as escaped text.
const claudeDesktopConfig = `{
  "mcpServers": {
    "datanika": {
      "command": "uvx",
      "args": [
        "datanika-mcp",
        "--url", "https://app.datanika.io",
        "--api-key", "etf_your_key_here"
      ]
    }
  }
}`;

const claudeDesktopWriteConfig = `{
  "mcpServers": {
    "datanika": {
      "command": "uvx",
      "args": [
        "datanika-mcp",
        "--url", "https://app.datanika.io",
        "--api-key", "etf_your_key_here",
        "--allow-write"
      ]
    }
  }
}`;

const cursorConfig = `{
  "mcpServers": {
    "datanika": {
      "command": "uvx",
      "args": ["datanika-mcp"],
      "env": {
        "DATANIKA_URL": "https://app.datanika.io",
        "DATANIKA_API_KEY": "etf_your_key_here"
      }
    }
  }
}`;

// The hosted endpoint. Verified end-to-end against production 2026-07-21:
// discovery -> dynamic registration -> consent -> token -> tools/call.
const HOSTED_URL = "https://app.datanika.io/mcp";
---

<DocsLayout
  title="MCP Server"
  description="Connect Datanika to Claude, ChatGPT, or Cursor over MCP — one click with the hosted endpoint, or locally with uvx datanika-mcp. 25 tools, read-only by default."
>
  <h1 class="gradient-text">MCP Server</h1>
  <p class="text-lg text-slate-400 mb-8">
    Give Claude, Cursor, or any MCP client direct access to your data pipelines —
    {toolCount} tools over the Datanika API, read-only by default.
  </p>

  <h2>What it is</h2>
  <p>
    Datanika speaks <a href="https://modelcontextprotocol.io" target="_blank" rel="noopener">Model Context Protocol</a>,
    which exposes the <a href="/api/reference">Datanika REST API</a> as {toolCount} typed tools.
    Instead of teaching your agent to read an OpenAPI spec and hand-roll HTTP calls, you point an
    MCP client at Datanika once and the agent gets first-class tools it can call directly.
  </p>
  <p>
    The server is open source (AGPL-3.0) and lives in the
    <a href="https://github.com/datanika-io/datanika-core/tree/master/datanika-mcp" target="_blank" rel="noopener">datanika-core</a>
    repository. It is published on PyPI as
    <a href="https://pypi.org/project/datanika-mcp/" target="_blank" rel="noopener">datanika-mcp</a>.
  </p>

  <h2 id="two-ways">Two ways to connect</h2>
  <p>
    Both expose the same tools against the same API. The difference is where the server runs and
    how you authenticate.
  </p>
  <table>
    <thead>
      <tr><th></th><th>Hosted — one click</th><th>Local — stdio</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><strong>Setup</strong></td>
        <td>Paste a URL, approve in your browser</td>
        <td>Edit a config file, paste an API key</td>
      </tr>
      <tr>
        <td><strong>Install</strong></td>
        <td>Nothing</td>
        <td><code>uv</code> / <code>uvx</code></td>
      </tr>
      <tr>
        <td><strong>Auth</strong></td>
        <td>OAuth 2.1 — no key handling</td>
        <td>An API key you create and paste</td>
      </tr>
      <tr>
        <td><strong>Writes</strong></td>
        <td>Off unless you grant them at consent</td>
        <td>Opt in with <code>--allow-write</code></td>
      </tr>
      <tr>
        <td><strong>Works with</strong></td>
        <td>Clients that support remote MCP servers</td>
        <td>Any MCP client, including self-hosted Datanika</td>
      </tr>
    </tbody>
  </table>
  <p>
    Use the hosted endpoint unless you self-host. Both paths can create and trigger things; they
    differ in how you say so — a browser approval on the hosted path, a command-line flag locally.
    See <a href="#read-only">read-only by default</a>.
  </p>

  <h2 id="one-click">Connect in one click (hosted)</h2>
  <p>
    Datanika hosts an MCP endpoint at <code>{HOSTED_URL}</code>. Add that URL wherever your client
    accepts a remote MCP server or custom connector, and it will walk you through authorizing in the
    browser. There is nothing to install and no API key to create, copy, or store in a config file.
  </p>
  <p>
    Which clients offer this, and where the setting lives, changes quickly enough that we will not
    try to describe their menus here. If yours has no remote-server option yet, use
    <a href="#local">the local path</a> — same tools, same API.
  </p>
  <p>What happens after you paste the URL:</p>
  <ol>
    <li>
      Your client discovers how to authenticate and <strong>registers itself</strong> automatically
      (<a href="https://datatracker.ietf.org/doc/html/rfc7591" target="_blank" rel="noopener">RFC 7591</a>).
      Nothing to pre-register on our side.
    </li>
    <li>
      A browser tab opens on Datanika. <strong>If you are not signed in, you sign in first</strong> and
      come straight back to the authorization request — you will not lose your place.
    </li>
    <li>
      You get a consent screen naming <strong>the app that asked</strong>, <strong>which organization</strong>
      it will read (switchable there if you belong to more than one), and exactly what it may do.
      Approve or deny.
    </li>
    <li>
      On approve, the browser hands a short-lived code back to your client, which exchanges it for an
      access token. Tokens last an hour and refresh silently. You are done.
    </li>
  </ol>
  <p>
    The grant is bound to the organization that was active when you approved. To connect a different
    organization, switch it on the consent screen before approving — or authorize again from the
    other organization.
  </p>

  <h3 id="revoking">Revoking access</h3>
  <p>
    Approving mints an API key in your organization named <code>MCP: &lt;app name&gt;</code> — the
    token your client holds maps to that key, so revoking the key ends the access immediately.
    Find it under <em>Settings → API Keys</em>, next to any key you made by hand, showing the same
    scope list and last-used time. See <a href="/api/keys">API Keys</a>.
  </p>
  <p>
    Each authorization creates its own key, so re-connecting an app adds a second one rather than
    replacing the first. If you have connected the same app a few times, revoke the older entries —
    last-used tells you which one is live.
  </p>

  <h3 id="hosted-security">What the grant can and cannot do</h3>
  <ul>
    <li>
      <strong>Read-only unless you granted write.</strong> The grant carries exactly the scopes you
      approved. A client that asks for nothing, or asks for something we don't recognise, gets the
      eight <code>*:read</code> scopes — <em>silence is never read as consent to write</em>. Write
      tools work only when the grant carries write scopes, and the refusal is enforced by the grant
      itself rather than by the transport.
    </li>
    <li>
      <strong>A pasted API key is always read-only here.</strong> If you authenticate to the hosted
      endpoint with a bearer key instead of the browser flow, write tools stay off even when that
      key's own scopes would permit writes. Nothing recorded a human decision, so this layer won't
      infer one. (Your key's scopes still bound what the REST API will do with it.)
    </li>
    <li>
      <strong>One organization.</strong> The organization comes from your signed-in session, not from
      the link you clicked, so a crafted authorization URL cannot aim the grant somewhere else.
    </li>
    <li>
      <strong>Revoking the key revokes the write access.</strong> The grant's authority travels with
      the credential, so removing the key in <strong>Settings → API Keys</strong> ends it — there is
      no second place to check.
    </li>
    <li>
      <strong>The app name is resolved by us</strong>, from what the client registered — not from the
      URL. What you read on the consent screen is what you are approving.
    </li>
    <li>
      <strong>PKCE is required</strong> (<code>S256</code>; <code>plain</code> is refused and not
      advertised), authorization codes are single-use and expire in five minutes, and refresh tokens
      rotate on every use.
    </li>
  </ul>

  <h2 id="local">Run it locally (stdio)</h2>
  <p>
    The local path runs the server on your machine over stdio: your MCP client starts the process,
    and the process talks to your Datanika instance over HTTPS with an API key you provide. Use it
    when you need write access, when you self-host, or when your client does not support remote MCP
    servers.
  </p>

  <h3 id="requirements">Requirements</h3>
  <ul>
    <li>
      <strong>A Datanika API key.</strong> Create one under <em>Settings → API Keys</em> in the app.
      See <a href="/api/keys">API Keys</a> for scopes and rotation. Keys are prefixed <code>etf_</code>.
    </li>
    <li>
      <strong><a href="https://docs.astral.sh/uv/" target="_blank" rel="noopener">uv</a></strong>, which ships
      the <code>uvx</code> runner. It downloads and caches the server on first use — you do not need to
      manage a Python environment yourself.
    </li>
  </ul>

  <h3 id="install">Install</h3>
  <p>Check that it resolves and runs:</p>
  <pre><code>uvx datanika-mcp --version
# datanika-mcp 0.2.0</code></pre>
  <p>
    That is the whole install. You will not normally run the command by hand — an MCP server
    speaks stdio, so your client launches it and owns the process. Running it in a terminal just
    prints a startup line and then waits for a client that will never speak.
  </p>

  <h3 id="claude-desktop">Claude Desktop</h3>
  <p>Edit your Claude Desktop config file:</p>
  <table>
    <thead>
      <tr><th>OS</th><th>Path</th></tr>
    </thead>
    <tbody>
      <tr>
        <td>macOS</td>
        <td><code>~/Library/Application Support/Claude/claude_desktop_config.json</code></td>
      </tr>
      <tr>
        <td>Windows</td>
        <td><code>%APPDATA%\Claude\claude_desktop_config.json</code></td>
      </tr>
    </tbody>
  </table>

  <p>Add a <code>datanika</code> entry:</p>
  <pre><code>{claudeDesktopConfig}</code></pre>

  <p>
    Restart Claude Desktop. The Datanika tools appear in the tools menu, and you can ask things like
    <em>"list my connections and show me the last five failed runs"</em> or
    <em>"preview the orders table on my production Postgres connection"</em>.
  </p>

  <h3 id="claude-code">Claude Code</h3>
  <p>One command, from the project you want the server available in:</p>
  <pre><code>claude mcp add datanika -- uvx datanika-mcp --api-key etf_your_key_here</code></pre>
  <p>
    Everything after <code>--</code> is the command Claude Code will launch. Add
    <code>--url https://your-instance.example.com</code> if you self-host.
  </p>

  <h3 id="cursor">Cursor</h3>
  <p>
    Add the server to <code>~/.cursor/mcp.json</code> for every project, or
    <code>.cursor/mcp.json</code> inside a single repository. This example configures it through
    environment variables instead of flags — both work everywhere:
  </p>
  <pre><code>{cursorConfig}</code></pre>

  <h3 id="other-clients">Any other MCP client</h3>
  <p>
    Locally it is a plain stdio MCP server, so any compliant client works. Configure it to run
    <code>uvx datanika-mcp</code> and pass configuration as flags or environment variables:
  </p>
  <table>
    <thead>
      <tr><th>Flag</th><th>Environment variable</th><th>Default</th><th>Purpose</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>--url</code></td>
        <td><code>DATANIKA_URL</code></td>
        <td><code>https://app.datanika.io</code></td>
        <td>Which Datanika instance to talk to</td>
      </tr>
      <tr>
        <td><code>--api-key</code></td>
        <td><code>DATANIKA_API_KEY</code></td>
        <td>—  <em>(required)</em></td>
        <td>Your API key. The server exits immediately without one</td>
      </tr>
      <tr>
        <td><code>--allow-write</code></td>
        <td><code>DATANIKA_ALLOW_WRITE</code></td>
        <td><code>false</code></td>
        <td>Enable the {writeCount} write tools. Set the variable to <code>true</code> or <code>1</code></td>
      </tr>
    </tbody>
  </table>

  <h2 id="read-only">Read-only by default</h2>
  <p>
    All {readCount} read tools are always available. The {writeCount} write tools are registered but
    refuse to execute unless write access is enabled, returning an error rather than acting. An agent
    cannot create a connection, change a model, or trigger a run by accident.
  </p>
  <p>This is deliberate. The common case — "help me understand and debug my pipelines" — needs no write access at all.</p>
  <p>
    How you enable them depends on which path you took, because the two record the decision
    differently — <code>--allow-write</code> is a local-only flag, and the hosted endpoint has no
    flag at all.
  </p>

  <h3 id="hosted-writes">Enabling writes on the hosted endpoint</h3>
  <p>
    Write access is granted <strong>at authorization time</strong>. When a client requests write
    scopes, you approve them in the browser once, and the API key that approval mints carries exactly
    those scopes. There is no runtime toggle and nothing to restart.
  </p>
  <p>Three properties are worth knowing before you approve one:</p>
  <ul>
    <li>
      <strong>Silence is not consent.</strong> A client that omits <code>scope</code>, or asks for
      something unrecognised, gets read-only. Clients omit it routinely, so this had to be the
      default rather than an error.
    </li>
    <li>
      <strong>A pasted API key stays read-only</strong> on this endpoint even if its scopes allow
      writes — see <a href="#hosted-security">what the grant can and cannot do</a>.
    </li>
    <li>
      <strong>There is no "may build but may not trigger" tier.</strong> The REST API gives
      <code>create_upload</code> and <code>trigger_upload</code> the same <code>uploads:write</code>
      scope, so a checkbox splitting them could only be enforced in the MCP layer while the
      credential still permitted both. That is a control the token doesn't back, so we didn't ship
      it. Spend is bounded by your key's rate limit and byte quota instead.
    </li>
  </ul>

  <p>
    The approval screen states which of these you are granting: a read-only grant shows a
    <em>Read-only</em> badge, and a write grant shows <em>Read and write</em> with the specific
    capabilities spelled out — <em>"Create, modify and delete connections, uploads, pipelines,
    transformations, schedules and notifications — and trigger runs"</em> — plus a caution that the
    app can spend your quota. Read it before approving; it is the only place the decision is recorded.
  </p>

  <h3>Enabling writes locally</h3>
  <p>Add <code>--allow-write</code> (or set <code>DATANIKA_ALLOW_WRITE=true</code>):</p>
  <pre><code>{claudeDesktopWriteConfig}</code></pre>

  <h3>What still protects you</h3>
  <ul>
    <li>
      <strong>The API key is the ceiling.</strong> The server has exactly the permissions of the key you
      give it — it cannot reach another organization or escalate its own scope.
    </li>
    <li>
      <strong><code>query_connection</code> is SELECT-only.</strong> Read-query enforcement happens
      server-side in Datanika, not in the agent's prompt.
    </li>
    <li>
      <strong>Compile before run.</strong> <code>compile_transformation</code> validates dbt SQL without
      touching your warehouse, so an agent can check its own work cheaply before executing anything.
    </li>
    <li>
      <strong>Everything is audited.</strong> Actions taken with an API key land in the
      <a href="/docs/audit-log">audit log</a> like any other action.
    </li>
  </ul>
  <p>
    Use a dedicated key for agent access rather than reusing one from CI. If an agent does something
    surprising, you can revoke that one key without breaking your other automations.
  </p>

  <h2 id="tools">The {toolCount} tools</h2>

  <h3>Read-only — always available ({readCount})</h3>
  {readTools.map((group) => (
    <>
      <h4>{group.group}</h4>
      <table>
        <thead>
          <tr><th>Tool</th><th>What it does</th></tr>
        </thead>
        <tbody>
          {group.tools.map((tool) => (
            <tr>
              <td><code>{tool.name}</code></td>
              <td>{tool.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))}

  <h3>Requires <code>--allow-write</code> ({writeCount})</h3>
  {writeTools.map((group) => (
    <>
      <h4>{group.group}</h4>
      <table>
        <thead>
          <tr><th>Tool</th><th>What it does</th></tr>
        </thead>
        <tbody>
          {group.tools.map((tool) => (
            <tr>
              <td><code>{tool.name}</code></td>
              <td>{tool.desc}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </>
  ))}

  <h2 id="self-hosted">Self-hosted instances</h2>
  <p>
    Point <code>--url</code> at whatever origin serves <code>/api/v1</code>. With the default
    <a href="/docs/self-hosting">Docker Compose setup</a> the API listens on port 8000:
  </p>
  <pre><code>uvx datanika-mcp --url http://localhost:8000 --api-key etf_your_key_here</code></pre>
  <p>
    If you run Datanika behind a reverse proxy, use the public origin instead — the same one you
    open in a browser.
  </p>
  <p>
    Your instance also serves its own <code>/mcp</code> endpoint and authorization server, so the
    <a href="#one-click">one-click flow</a> works against your own origin. It depends on your
    deployment knowing its public URLs: set <code>OAUTH_REDIRECT_BASE_URL</code> and
    <code>FRONTEND_URL</code> to the origins users actually reach, or the browser will be sent to
    <code>localhost</code> partway through authorizing. Your proxy must also pass
    <code>/mcp</code> to the backend and leave the response unbuffered — the transport holds a
    long-lived stream.
  </p>

  <h2 id="troubleshooting">Troubleshooting</h2>
  <table>
    <thead>
      <tr><th>Symptom</th><th>Cause and fix</th></tr>
    </thead>
    <tbody>
      <tr>
        <td><code>Error: --api-key or $DATANIKA_API_KEY is required</code></td>
        <td>No key reached the process. Client config files do not inherit your shell environment — put the key in the config itself, as <code>args</code> or <code>env</code>.</td>
      </tr>
      <tr>
        <td>The server does not appear in the client</td>
        <td>Restart the client fully after editing its config, and confirm <code>uvx</code> is on the PATH the client sees. On macOS, apps launched from the Dock do not read your shell profile — an absolute path to <code>uvx</code> is the reliable fix.</td>
      </tr>
      <tr>
        <td>Every tool returns 401</td>
        <td>The key is wrong, revoked, or belongs to a different instance than <code>--url</code>.</td>
      </tr>
      <tr>
        <td>Write tools say write access is required</td>
        <td>Working as designed — the server is read-only. Add <code>--allow-write</code> and restart the client.</td>
      </tr>
      <tr>
        <td>Connection errors against a self-hosted instance</td>
        <td><code>--url</code> is pointing at the frontend rather than the API. Use the origin that serves <code>/api/v1</code>.</td>
      </tr>
      <tr>
        <td>The one-click flow drops you on the dashboard instead of the consent screen</td>
        <td>You signed in with Google or GitHub, which does not yet carry you back to the pending request. Ask your client to connect again — you are signed in now, so the second attempt goes straight to consent.</td>
      </tr>
      <tr>
        <td>The consent screen says the request is incomplete or the app is not registered</td>
        <td>The authorization link was truncated or hand-edited. Start the connection from the client again rather than reusing the URL — nothing was shared.</td>
      </tr>
      <tr>
        <td>A hosted connection worked and then stopped</td>
        <td>Its API key was revoked, which is the intended off switch. Check <em>Settings → API Keys</em> for the <code>MCP:</code> entry, then reconnect from the client to mint a new grant.</td>
      </tr>
      <tr>
        <td>Write tools refuse over the hosted endpoint</td>
        <td>Working as designed and not configurable — the hosted path is read-only. Use the <a href="#local">local server</a> with <code>--allow-write</code>.</td>
      </tr>
    </tbody>
  </table>

