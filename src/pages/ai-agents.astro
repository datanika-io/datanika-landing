---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import ConversionCTA from "../components/ConversionCTA.astro";
import { tiers, tierCount } from "../data/agent-tiers";
import { availableConnectors, connectors } from "../data/connectors";

// Kept in the frontmatter so the JSON braces render as text without escaping.
// Mirrors /docs/mcp-server — if you change one, change both.
const mcpConfig = `{
  "mcpServers": {
    "datanika": {
      "command": "uvx",
      "args": [
        "datanika-mcp",
        "--api-key", "etf_your_key_here"
      ]
    }
  }
}`;

const competitors = [
  { feature: "/llms.txt discovery", datanika: true, fivetran: false, airbyte: false, stitch: false, hevo: false },
  { feature: "Agent strategy guide", datanika: true, fivetran: false, airbyte: false, stitch: false, hevo: false },
  { feature: "Typed config schemas in API", datanika: true, fivetran: false, airbyte: false, stitch: false, hevo: false },
  { feature: "Source introspection via API", datanika: true, fivetran: false, airbyte: true, stitch: false, hevo: false },
  { feature: "Compile-before-run validation", datanika: true, fivetran: false, airbyte: false, stitch: false, hevo: false },
  { feature: "Typed error codes for agents", datanika: true, fivetran: false, airbyte: false, stitch: false, hevo: false },
  { feature: "Idempotent retries", datanika: true, fivetran: true, airbyte: false, stitch: false, hevo: false },
  { feature: "Wait mode on run triggers", datanika: true, fivetran: false, airbyte: false, stitch: false, hevo: false },
];
---

<Layout
  title="AI Data Pipeline — Agent-Native ETL Tool | Datanika"
  description="Build data pipelines with AI agents that write portable dbt-core, not vendor lock-in. Agent API with /llms.txt discovery, typed config schemas, compile-before-run validation, and a 25-tool MCP server. Start free."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "AI Agents", url: "/ai-agents" },
  ]}
  ogCollection="pages"
  ogSlug="ai-agents"
>
  <Navbar />

  <!-- Hero -->
  <section class="relative pt-32 pb-20 overflow-hidden">
    <div class="glow bg-violet-600 -top-40 -left-40"></div>
    <div class="glow bg-cyan-600 -bottom-40 -right-40"></div>
    <div class="relative max-w-5xl mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 rounded-full border border-violet-500/30 bg-violet-500/10 px-4 py-1.5 text-sm text-violet-300 mb-6">
        <span>{tierCount}-Tier Agent API</span>
        <span class="text-violet-500">|</span>
        <span>Portable by default</span>
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight mb-6">
        <span class="gradient-text">AI Data Pipeline</span><br />
        Your Agent Writes dbt, Not Lock-In
      </h1>
      <p class="text-lg sm:text-xl text-slate-400 max-w-3xl mx-auto leading-relaxed mb-8">
        Datanika gives agents a full API to build pipelines — and runs
        <strong class="text-slate-200">real dbt-core and dlt</strong> underneath. Everything your agent builds
        here is a standard dbt project, so it runs anywhere dbt runs. Point your agent at
        <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-base">/llms.txt</code> and go.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <ConversionCTA href="https://app.datanika.io/signup" class="btn-primary">Get Your API Key</ConversionCTA>
        <a href="https://app.datanika.io/llms.txt" class="btn-secondary" target="_blank" rel="noopener">
          View /llms.txt
        </a>
      </div>
      <p class="mt-6 text-sm text-slate-500">
        Using Claude or Cursor?
        <a href="#mcp" class="text-violet-400 hover:underline">Install the MCP server &darr;</a>
      </p>
    </div>
  </section>

  <!-- Portability — the lead argument. An agent generates lock-in faster than a human can. -->
  <section id="portability" class="py-20 scroll-mt-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center mb-14">
        <h2 class="text-3xl font-bold mb-4">Lock-In Compounds at Machine Speed</h2>
        <p class="text-slate-400 max-w-3xl mx-auto leading-relaxed">
          A human analyst might write twenty models a quarter. An agent can write two hundred in an afternoon.
          If those land in a proprietary transformation format, you didn't automate your data stack — you
          automated your migration cost. The question to ask any agent-native platform is not how many tools
          its API exposes. It's <em>what your agent leaves behind</em>.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-6 items-stretch">
        <div class="rounded-2xl border border-emerald-500/25 bg-emerald-500/[0.04] backdrop-blur p-7">
          <div class="text-xs font-semibold uppercase tracking-widest text-emerald-400 mb-3">What Datanika writes</div>
          <h3 class="text-xl font-semibold text-white mb-3">A standard dbt project</h3>
          <ul class="space-y-2.5 text-sm text-slate-300">
            <li><span class="text-emerald-400 mr-2">&#10003;</span>SQL models with <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-xs">ref()</code> and <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-xs">source()</code></li>
            <li><span class="text-emerald-400 mr-2">&#10003;</span>dbt tests, snapshots, seeds and packages</li>
            <li><span class="text-emerald-400 mr-2">&#10003;</span>Extraction via <a href="https://dlthub.com" target="_blank" rel="noopener">dlt</a>, an open-source library</li>
            <li><span class="text-emerald-400 mr-2">&#10003;</span>Runs under plain <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-xs">dbt run</code> with no Datanika present</li>
          </ul>
          <p class="text-sm text-slate-400 mt-5 pt-5 border-t border-slate-800">
            Your team already knows this tooling, and so does every model trained on public dbt code — which
            is a large part of why agents are good at writing it.
          </p>
        </div>

        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur p-7">
          <div class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-3">What a bespoke engine writes</div>
          <h3 class="text-xl font-semibold text-white mb-3">Something only it can run</h3>
          <ul class="space-y-2.5 text-sm text-slate-300">
            <li><span class="text-slate-600 mr-2">&#10007;</span>Transformations in a vendor-specific DSL or JSON config</li>
            <li><span class="text-slate-600 mr-2">&#10007;</span>Tests and lineage expressed in a private format</li>
            <li><span class="text-slate-600 mr-2">&#10007;</span>Leaving means rewriting, not exporting</li>
            <li><span class="text-slate-600 mr-2">&#10007;</span>Your agent has to learn the format before it's useful</li>
          </ul>
          <p class="text-sm text-slate-400 mt-5 pt-5 border-t border-slate-800">
            "Open source" and "portable" are different claims. A platform can be fully open source and still
            leave you with logic that runs nowhere else.
          </p>
        </div>
      </div>

      <p class="text-center text-slate-400 text-sm mt-10 max-w-3xl mx-auto">
        This is also why we don't gate connectors by plan: all {availableConnectors.length} are on every tier, including free.
        We charge for volume, not for capability — see <a href="/pricing" class="text-violet-400 hover:underline">pricing</a>
        and <a href="/docs/self-hosting" class="text-violet-400 hover:underline">self-hosting</a>, where the whole thing runs on your own infrastructure under AGPL.
      </p>
    </div>
  </section>

  <!-- MCP server — the no-code path onto the same API the tiers below describe. -->
  <section id="mcp" class="py-20 scroll-mt-24">
    <div class="max-w-5xl mx-auto px-6">
      <div class="text-center">
        <div class="inline-flex items-center gap-2 rounded-full border border-cyan-500/30 bg-cyan-500/10 px-4 py-1.5 text-sm text-cyan-300 mb-6">
          <span>MCP</span>
          <span class="text-cyan-500">|</span>
          <span>25 tools</span>
        </div>
        <h2 class="text-3xl font-bold mb-4">Connect Claude in One Click</h2>
        <p class="text-slate-400 max-w-3xl mx-auto mb-12">
          Datanika speaks Model Context Protocol, exposing the API below as 25 typed tools. Your agent
          browses connections, previews tables, compiles dbt models, and reads run logs without writing a
          single HTTP call. Two ways in: paste our
          <strong class="text-slate-200">hosted endpoint</strong> and approve in the browser, or run
          <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-sm">uvx datanika-mcp</code>
          locally. Read-only by default either way.
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8 items-start">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/80 backdrop-blur overflow-hidden">
          <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-800 text-sm text-slate-500">
            <span class="h-3 w-3 rounded-full bg-red-500/60"></span>
            <span class="h-3 w-3 rounded-full bg-yellow-500/60"></span>
            <span class="h-3 w-3 rounded-full bg-green-500/60"></span>
            <span class="ml-2">the local path &mdash; claude_desktop_config.json</span>
          </div>
          <pre class="p-6 text-sm leading-relaxed overflow-x-auto"><code class="text-slate-300">{mcpConfig}</code></pre>
          <div class="px-6 pb-6 -mt-2">
            <p class="text-xs text-slate-500">
              Prefer no install? Paste
              <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-xs">https://app.datanika.io/mcp</code>
              wherever your client accepts a remote MCP server and authorize in the browser.
            </p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 backdrop-blur p-5">
            <h3 class="font-semibold text-white mb-1">Read-only by default</h3>
            <p class="text-sm text-slate-400">
              17 read tools are always available. The 8 write tools stay off until you say otherwise —
              approved once in the browser at
              <a href="/docs/mcp-server#hosted-writes" class="text-violet-400 hover:underline">authorization time</a>
              on the hosted endpoint, or with
              <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-xs">--allow-write</code>
              <a href="/docs/mcp-server#local" class="text-violet-400 hover:underline">locally</a>. A client
              that asks for nothing gets read-only.
            </p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 backdrop-blur p-5">
            <h3 class="font-semibold text-white mb-1">Your choice where it runs</h3>
            <p class="text-sm text-slate-400">
              Hosted: OAuth in the browser, nothing to install, no key to store. Local:
              <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-xs">uvx datanika-mcp</code>
              over stdio, with an API key that never leaves your machine — the path to use against a
              self-hosted instance.
            </p>
          </div>
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 backdrop-blur p-5">
            <h3 class="font-semibold text-white mb-1">Works with any MCP client</h3>
            <p class="text-sm text-slate-400">
              Clients that support remote MCP servers can use the hosted URL directly. Everything else —
              Claude Desktop, Claude Code, Cursor — connects over stdio with a copy-paste config from the docs.
            </p>
          </div>
          <div class="flex flex-col sm:flex-row gap-4 pt-2">
            <a href="/docs/mcp-server" class="btn-primary">MCP Setup Guide</a>
            <a href="https://pypi.org/project/datanika-mcp/" class="btn-secondary" target="_blank" rel="noopener">
              View on PyPI
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Capability Tiers (SoT-driven from /api/v1/meta/agent-tiers) -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">{tierCount} Capability Tiers</h2>
      <p class="text-slate-400 text-center max-w-2xl mx-auto mb-12">
        Everything an autonomous agent needs to build a complete data pipeline — from discovering connection types to monitoring scheduled runs. The tiers are the API surface Datanika exposes; each one groups related endpoints an agent calls in order.
      </p>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {tiers.map((tier) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 backdrop-blur p-6 transition-colors hover:border-violet-500/30">
            <div class="flex items-center gap-3 mb-3">
              <span class="inline-flex h-8 w-8 items-center justify-center rounded-lg bg-violet-500/10 text-sm font-bold text-violet-400">
                {tier.number}
              </span>
              <h3 class="text-lg font-semibold text-white">{tier.name}</h3>
            </div>
            <p class="text-sm text-slate-400 mb-3">{tier.summary}</p>
            <ul class="space-y-2">
              {tier.capabilities.map((cap) => (
                <li class="text-xs text-slate-500">
                  <span class="text-slate-300 font-medium">{cap.name}</span>
                  <code class="block mt-1 bg-slate-900 rounded px-2 py-1.5 break-all">
                    {cap.endpoints.slice(0, 2).join(", ")}{cap.endpoints.length > 2 ? ", …" : ""}
                  </code>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Code Example -->
  <section class="py-20">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">Build a Pipeline in 10 Lines</h2>
      <p class="text-slate-400 text-center max-w-2xl mx-auto mb-10">
        Tell your AI agent to read <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-sm">/llms.txt</code>, or use the API directly with any HTTP client.
      </p>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/80 backdrop-blur overflow-hidden">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-slate-800 text-sm text-slate-500">
          <span class="h-3 w-3 rounded-full bg-red-500/60"></span>
          <span class="h-3 w-3 rounded-full bg-yellow-500/60"></span>
          <span class="h-3 w-3 rounded-full bg-green-500/60"></span>
          <span class="ml-2">agent_pipeline.py</span>
        </div>
        <pre class="p-6 text-sm leading-relaxed overflow-x-auto"><code class="text-slate-300">import httpx

BASE = "https://app.datanika.io/api/v1"
H = {"{"}\"Authorization\": \"Bearer etf_your_key\"{"}"}

<span class="text-slate-500"># 1. Discover available connection types (full JSON Schema)</span>
types = httpx.get(f"{"{"}BASE{"}"}/meta/connection-types", headers=H).json()

<span class="text-slate-500"># 2. Create source + destination</span>
src = httpx.post(f"{"{"}BASE{"}"}/connections", headers=H, json={"{"}
    "name": "Stripe", "connection_type": "stripe",
    "config": {"{"}\"api_key\": \"sk_live_...\"{"}"}
{"}"}).json()

dst = httpx.post(f"{"{"}BASE{"}"}/connections", headers=H, json={"{"}
    "name": "BigQuery", "connection_type": "bigquery",
    "config": {"{"}\"project\": \"analytics\", \"dataset\": \"raw\", \"service_account_json\": \"{"{"}...{"}"}\"{"}"}
{"}"}).json()

<span class="text-slate-500"># 3. Introspect source, build upload, run with wait mode</span>
tables = httpx.post(f"{"{"}BASE{"}"}/connections/{"{"}src['id']{"}"}/introspect", headers=H).json()
upload = httpx.post(f"{"{"}BASE{"}"}/uploads", headers=H, json={"{"}
    "name": "Stripe Charges", "source_connection_id": src["id"],
    "destination_connection_id": dst["id"],
    "dlt_config": {"{"}\"mode\": \"single_table\", \"table\": \"charges\"{"}"}
{"}"}).json()
run = httpx.post(f"{"{"}BASE{"}"}/uploads/{"{"}upload['id']{"}"}/run?wait=true", headers=H).json()

<span class="text-slate-500"># 4. Write + validate a transformation</span>
model = httpx.post(f"{"{"}BASE{"}"}/transformations", headers=H, json={"{"}
    "name": "monthly_revenue", "destination_connection_id": dst["id"],
    "sql": "SELECT date_trunc('month', created) as month, sum(amount)/100 as revenue FROM {"{"}{"{"} source('raw', 'charges') {"}"}{"}"} GROUP BY 1"
{"}"}).json()
httpx.post(f"{"{"}BASE{"}"}/transformations/{"{"}model['id']{"}"}/compile", headers=H)  <span class="text-slate-500"># validate first!</span>
httpx.post(f"{"{"}BASE{"}"}/transformations/{"{"}model['id']{"}"}/preview", headers=H)  <span class="text-slate-500"># preview output</span></code></pre>
      </div>
      <p class="text-center text-slate-500 text-sm mt-4">
        Or just tell your agent: <em>"Read https://app.datanika.io/llms.txt and build me a Stripe-to-BigQuery pipeline."</em>
      </p>
    </div>
  </section>

  <!-- Discovery Documents -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-12">Machine-Readable Discovery</h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur p-8">
          <div class="flex items-center gap-3 mb-4">
            <code class="text-violet-400 font-semibold text-lg">/llms.txt</code>
            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs text-emerald-400">No auth required</span>
          </div>
          <p class="text-slate-400 text-sm mb-4">
            Plain-text discovery document at the site root. Contains the API summary, base URL, authentication format, rate limits by plan, and the complete {tierCount}-tier capability list.
          </p>
          <p class="text-slate-400 text-sm mb-4">Point any LLM here first.</p>
          <a href="https://app.datanika.io/llms.txt" class="text-violet-400 text-sm hover:underline" target="_blank" rel="noopener">
            View /llms.txt &rarr;
          </a>
        </div>
        <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur p-8">
          <div class="flex items-center gap-3 mb-4">
            <code class="text-violet-400 font-semibold text-lg">/api/v1/agent-guide.md</code>
            <span class="rounded-full bg-emerald-500/10 px-2 py-0.5 text-xs text-emerald-400">No auth required</span>
          </div>
          <p class="text-slate-400 text-sm mb-4">
            Markdown strategy guide for LLM agents. A 17-step golden-path loop from discovery to monitoring, typed error codes with recovery actions, idempotency patterns, and explicit "what the API cannot do" to prevent hallucination loops.
          </p>
          <a href="https://app.datanika.io/api/v1/agent-guide.md" class="text-violet-400 text-sm hover:underline" target="_blank" rel="noopener">
            View Agent Guide &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Competitor Comparison -->
  <section class="py-20">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-3xl font-bold text-center mb-4">How Competitors Compare</h2>
      <p class="text-slate-400 text-center max-w-2xl mx-auto mb-12">
        As of April 2026: Fivetran has no agent API. Airbyte has no <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-sm">/llms.txt</code>. dbt Cloud has no compile-before-run via API.
      </p>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur overflow-hidden overflow-x-auto">
        <table class="w-full text-left text-sm">
          <thead>
            <tr class="border-b border-slate-800">
              <th class="px-4 py-3 text-slate-400 font-semibold">Capability</th>
              <th class="px-4 py-3 text-center text-violet-400 font-semibold">Datanika</th>
              <th class="px-4 py-3 text-center text-slate-500 font-semibold">Fivetran</th>
              <th class="px-4 py-3 text-center text-slate-500 font-semibold">Airbyte</th>
              <th class="px-4 py-3 text-center text-slate-500 font-semibold">Stitch</th>
              <th class="px-4 py-3 text-center text-slate-500 font-semibold">Hevo</th>
            </tr>
          </thead>
          <tbody>
            {competitors.map((row, i) => (
              <tr class={`border-b border-slate-800/50 ${i % 2 === 0 ? "bg-slate-900/30" : ""}`}>
                <td class="px-4 py-3 text-slate-300">{row.feature}</td>
                <td class="px-4 py-3 text-center">{row.datanika ? <span class="text-emerald-400">&#10003;</span> : <span class="text-red-400/60">&#10007;</span>}</td>
                <td class="px-4 py-3 text-center">{row.fivetran ? <span class="text-emerald-400">&#10003;</span> : <span class="text-red-400/60">&#10007;</span>}</td>
                <td class="px-4 py-3 text-center">{row.airbyte ? <span class="text-emerald-400">&#10003;</span> : <span class="text-red-400/60">&#10007;</span>}</td>
                <td class="px-4 py-3 text-center">{row.stitch ? <span class="text-emerald-400">&#10003;</span> : <span class="text-red-400/60">&#10007;</span>}</td>
                <td class="px-4 py-3 text-center">{row.hevo ? <span class="text-emerald-400">&#10003;</span> : <span class="text-red-400/60">&#10007;</span>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="text-xs text-slate-500 mt-4 text-center max-w-3xl mx-auto">
        Comparison current as of 2026-04-13. Sources: <a href="https://www.fivetran.com/docs/rest-api" class="underline hover:text-slate-400" target="_blank" rel="noopener">Fivetran REST API docs</a>, <a href="https://reference.airbyte.com/reference/start" class="underline hover:text-slate-400" target="_blank" rel="noopener">Airbyte API reference</a>, <a href="https://www.stitchdata.com/docs/developers/stitch-connect/api" class="underline hover:text-slate-400" target="_blank" rel="noopener">Stitch Connect API</a>, <a href="https://hevodata.com/learn/rest-api" class="underline hover:text-slate-400" target="_blank" rel="noopener">Hevo REST API</a>, <a href="https://docs.getdbt.com/dbt-cloud/api-v2-legacy" class="underline hover:text-slate-400" target="_blank" rel="noopener">dbt Cloud API</a>. We update this when a competitor ships a new agent-facing feature.
      </p>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur p-12">
        <h2 class="text-3xl font-bold mb-4">Ship Your First Agent-Built Pipeline</h2>
        <p class="text-slate-400 mb-8 text-lg">
          Free tier includes 500 model runs/month. Create an API key, point your agent at
          <code class="text-violet-300 bg-slate-800 px-1.5 py-0.5 rounded text-sm">/llms.txt</code>, and watch it build.
        </p>
