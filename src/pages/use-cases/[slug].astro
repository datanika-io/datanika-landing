---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import ConversionCTA from "../../components/ConversionCTA.astro";
import { getCollection } from "astro:content";
import { isPostVisible } from "../../utils/blog-visibility";
import { useCases } from "../../data/use-cases";
import type { UseCase } from "../../data/use-cases";
import { connectors } from "../../data/connectors";

// A use case and a tutorial that share a slug are the same intent at two depths,
// and until now they competed instead of stacking: GSC has both
// `/use-cases/postgresql-to-bigquery/` (57.5) and `/blog/postgresql-to-bigquery/`
// (57.3) ranking for `export postgresql to bigquery` in the same 30 days, with
// the impressions split 28/11 and neither near the surface (#380).
//
// Derived by slug rather than listed by hand, so a new tutorial that matches a
// use case is linked the day it publishes and an unpublished one is not linked
// at all — a scheduled post is excluded from the build entirely, so a hardcoded
// href would 404 until its publish date.
export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => isPostVisible(data));
  const bySlug = new Map(posts.map((p) => [p.id.replace(/\.mdx?$/, ""), p]));
  return useCases.map((uc) => {
    const post = bySlug.get(uc.slug);
    return {
      params: { slug: uc.slug },
      props: {
        useCase: uc,
        deepDive: post ? { slug: uc.slug, title: post.data.title } : null,
      },
    };
  });
}

interface Props {
  useCase: UseCase;
  deepDive: { slug: string; title: string } | null;
}

const { useCase, deepDive } = Astro.props;

const breadcrumbs = [
  { name: "Home", url: "/" },
  { name: "Use Cases", url: "/use-cases" },
  { name: useCase.title, url: `/use-cases/${useCase.slug}` },
];

// SEO overrides from plans/SEO_KEYWORDS.md Tier 1 rewrite pass.
// Falls back to default pattern when not set.
const pageTitle = useCase.seoTitle ?? `${useCase.title} Pipeline — Datanika`;
const pageDescription = useCase.seoDescription ?? useCase.description;
const pageH1 = useCase.seoH1 ?? useCase.title;

// A use case is a promise about two connectors, so it inherits their
// availability. Derived from `connectors.ts` rather than flagged on the use case
// itself: a hand-set flag here would be a second copy of the same fact, and the
// one that rots is always the copy. When core#863 restores S3 the notice
// disappears from every page that names it, with no edit here.
const withdrawnHalves = [useCase.sourceSlug, useCase.destinationSlug]
  .map((slug) => connectors.find((c) => c.slug === slug))
  .filter((c): c is NonNullable<typeof c> => Boolean(c?.withdrawn));
---

<Layout
  title={pageTitle}
  description={pageDescription}
  breadcrumbs={breadcrumbs}
  ogCollection="use-cases"
  ogSlug={useCase.slug}
>
  <Navbar />

  <!-- Hero -->
  <section class="relative pt-32 pb-16 overflow-hidden">
    <div class="glow bg-violet-600 -top-40 -left-40"></div>
    <div class="glow bg-cyan-600 -bottom-40 -right-40"></div>
    <div class="relative max-w-4xl mx-auto px-6">
      <div class="flex items-center gap-2 text-sm text-slate-500 mb-4">
        <a href={`/connectors/${useCase.sourceSlug}`} class="px-2 py-0.5 rounded-full bg-slate-800 text-slate-400 hover:text-white transition-colors">{useCase.source}</a>
        <span class="text-slate-600">→</span>
        <a href={`/connectors/${useCase.destinationSlug}`} class="px-2 py-0.5 rounded-full bg-violet-500/20 text-violet-300 hover:text-white transition-colors">{useCase.destination}</a>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight mb-4">
        <span class="gradient-text">{pageH1}</span>
      </h1>
      <p class="text-lg text-slate-400 leading-relaxed max-w-3xl">
        {useCase.description}
      </p>
      {withdrawnHalves.length > 0 && (
        <div class="mt-6 rounded-2xl border border-amber-500/40 bg-amber-500/10 p-5 max-w-3xl">
          <p class="text-sm font-semibold text-amber-200 mb-2">
            This pipeline cannot be built right now
          </p>
          {withdrawnHalves.map((c) => (
            <p class="text-sm text-slate-300 leading-relaxed">{c.withdrawn}</p>
          ))}
          <p class="text-sm text-slate-400 leading-relaxed mt-2">
            The steps below are unchanged and stay published for when it returns.
          </p>
        </div>
      )}
      <div class="flex flex-col sm:flex-row gap-4 mt-8">
        <ConversionCTA href="https://app.datanika.io" class="btn-primary">Start Free</ConversionCTA>
        <a href="/use-cases" class="btn-secondary">View all use cases</a>
      </div>
    </div>
  </section>

  <!-- Why -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-4">Why {useCase.source} to {useCase.destination}?</h2>
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur p-6">
        <p class="text-slate-300 leading-relaxed">{useCase.why}</p>
      </div>
    </div>
  </section>

  <!-- Steps -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6">How to Set Up This Pipeline</h2>
      <ol class="space-y-4">
        {useCase.steps.map((step, i) => (
          <li class="flex gap-4">
            <span class="flex items-center justify-center w-8 h-8 rounded-full bg-violet-500/20 text-violet-300 font-bold text-sm shrink-0">{i + 1}</span>
            <div class="pt-1">
              <p class="text-slate-300">{step}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Transform Examples -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6">Transform Ideas with dbt</h2>
      <p class="text-slate-400 mb-6">Once your data is loaded, use Datanika's built-in dbt transformations to create analytics-ready models:</p>
      <div class="grid sm:grid-cols-2 gap-4">
        {useCase.transformExamples.map((ex) => (
          <div class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 flex items-start gap-3">
            <span class="text-emerald-400 mt-0.5 shrink-0">&#10003;</span>
            <p class="text-slate-300">{ex}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Connector Links -->
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-2xl font-bold mb-6">Connector Details</h2>
      <div class="grid sm:grid-cols-2 gap-4">
        <a href={`/connectors/${useCase.sourceSlug}`} class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-violet-500/50">
          <p class="text-sm text-slate-500 mb-1">Source</p>
          <p class="font-semibold text-white">{useCase.source} Connector</p>
          <p class="text-sm text-slate-400 mt-1">Setup guide, config fields, and more use cases →</p>
        </a>
        <a href={`/connectors/${useCase.destinationSlug}`} class="rounded-xl border border-slate-800 bg-slate-900/50 p-5 transition-colors hover:border-violet-500/50">
          <p class="text-sm text-slate-500 mb-1">Destination</p>
          <p class="font-semibold text-white">{useCase.destination} Connector</p>
          <p class="text-sm text-slate-400 mt-1">Setup guide, config fields, and more use cases →</p>
        </a>
      </div>
    </div>
  </section>

  <!-- Compare Alternatives -->
  <section class="py-8">
    <div class="max-w-4xl mx-auto px-6">
      <p class="text-sm text-slate-500">Evaluating ELT tools? Compare Datanika with{" "}
        <a href="/compare/airbyte" class="text-violet-400 hover:underline">Airbyte</a>,{" "}
        <a href="/compare/fivetran" class="text-violet-400 hover:underline">Fivetran</a>,{" "}
        <a href="/compare/stitch" class="text-violet-400 hover:underline">Stitch</a>, and{" "}
        <a href="/compare/hevo" class="text-violet-400 hover:underline">Hevo</a>.
        See the <a href="/docs/getting-started" class="text-violet-400 hover:underline">Getting Started guide</a> to build this pipeline in 5 minutes.
      </p>
      {deepDive && (
        <p class="mt-4 text-sm text-slate-400">
          Want the long version? <a href={`/blog/${deepDive.slug}/`} class="text-violet-400 hover:underline">{deepDive.title}</a>{" "}
          walks through the same pipeline screen by screen.
        </p>
      )}
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <div class="rounded-2xl border border-slate-800 bg-slate-900/50 backdrop-blur p-12">
        <h2 class="text-3xl font-bold mb-4">
          Ready to build your {useCase.source} to {useCase.destination} pipeline?
        </h2>
        <p class="text-slate-400 mb-8 text-lg">
          Free to start — connect {useCase.source} and {useCase.destination} in minutes.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <ConversionCTA href="https://app.datanika.io" class="btn-primary">Start Free</ConversionCTA>
          <a href="https://github.com/datanika-io/datanika-core" class="btn-secondary">View on GitHub</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Layout>
