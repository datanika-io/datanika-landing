---
// Drop-in replacement for `<a>` that fires a Plausible custom event on click,
// using navigator.sendBeacon() - which survives navigation, unlike the
// XHR+setTimeout path in script.tagged-events.js that was losing events on
// click-then-navigate (see landing#212).
//
// Usage:
//   <ConversionCTA href="..." class="btn-primary">Start Free</ConversionCTA>
//   <ConversionCTA href="..." class="btn-primary" plausibleEvent="Pricing: Start free">
//     Start Free
//   </ConversionCTA>
//
// Without `plausibleEvent` it renders a plain <a> and the handler below does not
// match it: normal navigation, no interception, no 50 ms delay.
//
// Any anchor can opt in without using this component - set
// `data-plausible-event="Event Name"`. The selector is on the attribute, not on
// the component, which is how /pricing's "Contact sales" link is tracked.
//
// IMPORTANT: there is deliberately NO Google Ads / gtag conversion here
// (landing#481). The tag this used to fire contradicted /privacy section 8.
// Re-adding it means changing /privacy and /trust in the same commit;
// tests/no-advertising-tag.test.ts enforces that. Plausible is the only
// measurement this component performs.

interface Props {
  href: string;
  class?: string;
  plausibleEvent?: string;
  [key: string]: any;
}

const { href, class: className, plausibleEvent, ...rest } = Astro.props;
---

<a
  href={href}
  class={className}
  data-plausible-event={plausibleEvent || undefined}
  {...rest}
>
  <slot />
</a>

<script>
  document.addEventListener(
    "click",
    (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const link = target.closest?.(
        "a[data-plausible-event]",
      ) as HTMLAnchorElement | null;
      if (!link) return;

      const href = link.getAttribute("href");
      const eventName = link.getAttribute("data-plausible-event");

      const sendPlausible = () => {
        if (!eventName || !navigator.sendBeacon) return;
        try {
          navigator.sendBeacon(
            "https://plausible.datanika.io/api/event",
            JSON.stringify({
              n: eventName,
              u: window.location.href,
              d: "datanika.io",
              r: document.referrer || null,
            }),
          );
        } catch (_) {
          /* sendBeacon rejected (CSP, quota, extension) — silent. */
        }
      };

      const me = e as MouseEvent;
      const isModifierClick =
        me.ctrlKey ||
        me.metaKey ||
        me.shiftKey ||
        (me.button !== undefined && me.button !== 0);

      if (isModifierClick) {
        e.stopImmediatePropagation();
        sendPlausible();
        return;
      }

      e.preventDefault();
      e.stopImmediatePropagation();
      sendPlausible();
      if (href) setTimeout(() => {
        window.location.href = href;
      }, 50);
    },
    true,
  );
</script>
