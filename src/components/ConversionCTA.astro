---
// Drop-in replacement for `<a>` that fires a Plausible custom event on click,
// using navigator.sendBeacon() - which survives navigation, unlike the
// XHR+setTimeout path in script.tagged-events.js that was losing events on
// click-then-navigate (see landing#212).
//
// Usage:
//   <ConversionCTA href="..." class="btn-primary">Start Free</ConversionCTA>
//   <ConversionCTA href="..." class="btn-primary" plausibleEvent="Pricing: Start free">
//     Start Free
//   </ConversionCTA>
//
// Without `plausibleEvent` it renders a plain <a> and the handler below does not
// match it: normal navigation, no interception, no 50 ms delay.
//
// 🚨 THE CONSEQUENCE OF THAT, which is what actually cost us (landing#515):
// an untagged CTA is INVISIBLE. It is not "tracked with a default name" and it
// is not "counted as a pageview click" — it emits nothing, forever, and the
// Goals report looks exactly the same as if nobody had clicked it. 23 of the 24
// call sites were untagged, so the whole measured record of signup intent on
// this site was ONE button on /pricing — 6 visitors over 6 months, quoted more
// than once as the site's click-through when it is one page's click-through.
// The behaviour above was documented; this consequence was not, and the
// consequence is the half that was missed.
//
// 🚨 AND TAGGING IS NOT ENOUGH ON ITS OWN. Plausible only surfaces a custom
// event in the Goals report if that goal is CONFIGURED in site settings, which
// needs Plausible admin. Shipping a new `plausibleEvent` name without creating
// the goal first gives a fully instrumented-looking site, a green deploy, and a
// report that never mentions it. The Stats API is the check, not the settings
// page. A name that is not a goal is refused ("is not configured"). A
// configured goal that has been clicked returns a row from
// /api/v1/stats/breakdown?property=event:goal.
//
// Measured 2026-11-11, before the call sites below were tagged. A 12-month
// breakdown returned exactly two rows: "Pricing: Start free" (6 visitors) and
// "Pricing: Contact sales" (2 visitors). "Signup: Start free" is not
// configured. Every ConversionCTA therefore uses "Pricing: Start free", the
// one signup goal that already returns a row. One name, because each extra
// name is a goal somebody has to create by hand. The label still says
// Pricing. The clicks now include every signup CTA, and the two "Try this
// template" buttons, not only /pricing. Do not rename it until a new goal
// returns a row.
//
// Any anchor can opt in without using this component - set
// `data-plausible-event="Event Name"`. The selector is on the attribute, not on
// the component, which is how /pricing's "Contact sales" link is tracked.
//
// IMPORTANT: there is deliberately NO Google Ads / gtag conversion here
// (landing#481). The tag this used to fire contradicted /privacy section 8.
// Re-adding it means changing /privacy and /trust in the same commit;
// tests/no-advertising-tag.test.ts enforces that. Plausible is the only
// measurement this component performs.

interface Props {
  href: string;
  class?: string;
  plausibleEvent?: string;
  [key: string]: any;
}

const { href, class: className, plausibleEvent, ...rest } = Astro.props;
---

<a
  href={href}
  class={className}
  data-plausible-event={plausibleEvent || undefined}
  {...rest}
>
  <slot />
</a>

<script>
  document.addEventListener(
    "click",
    (e) => {
      const target = e.target as HTMLElement | null;
      if (!target) return;
      const link = target.closest?.(
        "a[data-plausible-event]",
      ) as HTMLAnchorElement | null;
      if (!link) return;

      const href = link.getAttribute("href");
      const eventName = link.getAttribute("data-plausible-event");

      const sendPlausible = () => {
        if (!eventName || !navigator.sendBeacon) return;
        try {
          navigator.sendBeacon(
            "https://plausible.datanika.io/api/event",
            JSON.stringify({
              n: eventName,
              u: window.location.href,
              d: "datanika.io",
              r: document.referrer || null,
            }),
          );
        } catch (_) {
          /* sendBeacon rejected (CSP, quota, extension) — silent. */
        }
      };

      const me = e as MouseEvent;
      const isModifierClick =
        me.ctrlKey ||
        me.metaKey ||
        me.shiftKey ||
        (me.button !== undefined && me.button !== 0);

      if (isModifierClick) {
        e.stopImmediatePropagation();
        sendPlausible();
        return;
      }

      e.preventDefault();
      e.stopImmediatePropagation();
      sendPlausible();
      if (href) setTimeout(() => {
        window.location.href = href;
      }, 50);
    },
    true,
  );
</script>
