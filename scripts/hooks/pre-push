#!/usr/bin/env bash
# pre-push hook — runs build + tests before every push.
# Mirrors the CI gate (astro build, vitest).
# Install: git config core.hooksPath scripts/hooks
set -e

REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT"

# --- what is actually being pushed? (landing#504) --------------------------------------
# Git feeds the hook one line per ref on STDIN:  <local ref> <local sha> <remote ref> <remote sha>
# This hook used to read no stdin at all, so it could not tell a refspec push from a branch
# push. The post-promotion resync `git push origin origin/main:refs/heads/dev` names a
# remote-tracking ref, introduces ZERO new objects, and has nothing for a build to validate
# -- yet the hook built and tested whatever happened to be checked out, and `set -e` let an
# unrelated tree's failure refuse the push. On 2026-09-04 that resync silently did not
# happen and `dev` was left behind `main`.
#
# Third instance of one defect: datanika-core fixed it in core#556, datanika-cloud in
# cloud#131. This is the port.
#
# Consume stdin FIRST: anything below that reads stdin would otherwise eat these lines.
HEAD_SHA=$(git rev-parse HEAD 2>/dev/null || echo "")
PUSHING_HEAD=0
SAW_ANY=0
while read -r _lref lsha _rref _rsha; do
  SAW_ANY=1
  [ "$lsha" = "$HEAD_SHA" ] && PUSHING_HEAD=1
done
# No lines at all means git told us nothing (or the hook was invoked by hand) -- assume a
# normal push and check, rather than skipping silently. That arm is load-bearing: skipping
# on an empty stdin would turn this guard into a way to never run the gate at all.
if [ "$SAW_ANY" = "1" ] && [ "$PUSHING_HEAD" = "0" ]; then
  echo "pre-push: pushing a ref that is not HEAD (refspec push) — skipping build and tests."
  echo "          Your working tree is irrelevant to what is being pushed."
  exit 0
fi

# --- attribution trailers (landing#622; ported from datanika-core, core#1385) --------------
# The founder's standing ruling is that no commit message carries an attribution trailer. It is
# refused HERE, before the push, because a trailer on `dev` or `main` cannot be removed without a
# force-push. Blocks rather than warns, and prints its controls' readings beside its verdict.
# Placed before the build, so a refused push does not first pay for one.
# scripts/test-pre-push-guard.sh cases 9-11 drive this block through the real hook.
echo "pre-push: attribution trailers (landing#622)"
ATRC=0
node scripts/check-attribution-trailers.mjs --range 'origin/dev..HEAD' || ATRC=$?
if [ "$ATRC" -eq 2 ]; then
  echo "  pre-push WARNING: could not read origin/dev..HEAD for the trailer check."
  echo "      This measured NOTHING. Re-run after 'git fetch origin' if the range is stale."
elif [ "$ATRC" -ne 0 ]; then
  exit 1
fi

echo "pre-push: npm run build"
npm run build
echo "pre-push: npm test"
npm test
echo "pre-push: all checks passed"
